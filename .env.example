# Copy to .env on the server and fill in. Never commit the real file.

# Postgres database the ETL writes to and Superset reads from.
# Use its own database, not the one Superset keeps its settings in.
DATABASE_URL=postgresql://biotopia_etl:CHANGE_ME@localhost:5432/biotopia_analytics

# REDCap project BIOTOPIA: API URL ends in /api/. Use a read-only token.
REDCAP_API_URL=https://redcap.example.org/api/
REDCAP_API_TOKEN=

# DHIS2 (ichisplus.eu). Either a personal access token, or a username and password.
DHIS2_URL=https://ichisplus.eu
DHIS2_TOKEN=
DHIS2_USERNAME=
DHIS2_PASSWORD=

# Tracker programs to read, as arm:uid, comma separated.
# vH93guwEMVt is the iCHIS+ program. Add control:<uid> once the iCHIS program is known.
DHIS2_PROGRAMS=intervention:vH93guwEMVt
